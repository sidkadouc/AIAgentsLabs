# Copy this file to .env and update with your Azure AD configuration

# Original Azure OpenAI settings
GLOBAL_LLM_SERVICE="AzureOpenAI"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME="text-embedding-ada-002"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4o-mini"
AZURE_OPENAI_API_VERSION="2024-05-01-preview"
PROJECT_CONNECTION_STRING="your-project-connection-string"
GITHUB_TOKEN="your-github-token"
AZURE_SEARCH_SERVICE_ENDPOINT="https://your-search-service.search.windows.net/"
AZURE_SEARCH_API_KEY="your-search-api-key"
AZURE_SUBSCRIPTION_ID="your-subscription-id"
AZURE_AI_PROJECT_NAME="your-ai-project-name"
AZURE_OPENAI_RESOURCE_GROUP="your-resource-group"
AZURE_OPENAI_SERVICE="your-openai-service"

# Azure Active Directory Authentication Configuration
# To set up Azure AD authentication:
# 1. Register an application in Azure AD (https://portal.azure.com)
# 2. Add "http://localhost:8000/auth/oauth/azure-ad/callback" as a redirect URI
# 3. Generate a client secret
# 4. Copy the values below from your Azure AD app registration

OAUTH_AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
OAUTH_AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
OAUTH_AZURE_AD_TENANT_ID="your-azure-ad-tenant-id"